{
  "expo": {
    "name": "Eco+",
    "slug": "eco+",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "eco+",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ecotech.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4FBF5"
      },
      "package": "com.ecotech.app"
    },
    "extra": {
      "apiBaseUrl": "http://192.168.1.5:8001/v1"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o Eco+ use a câmera para escanear QR Codes das máquinas de reciclagem."
        }
      ],
      "expo-secure-store"
    ]
  }
}
