APP_NAME="Eco Mais Smart Recycling"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eco_mais_db

SECRET_KEY=change-this-development-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ENABLE_SIGNATURE_VERIFICATION=true
LOCAL_STORAGE_PATH=./uploads/images
AI_MODEL_PATH=./ml/models/recyclable_classifier.pt
USE_GPU=false

CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8081"]
